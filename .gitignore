.DS_Store
.build/
.build-cache/
.swiftpm/
.cache/
.local/

# Local experiments are not part of the Rune app path.
go/

# Packaged .app from scripts/build-macos-app.sh (reproducible via swift build).
dist/

# Local generated files.
assets/readme/kubeconfig.fake-cluster.yaml

# Local runtime state.
.rune-fake-k8s/
.rune-compose-fake-k8s/

# Generated test reports / local CI exports.
rune-smoke-swift-testing.xml
test-reports/

# Full UI smoke screenshot runs are local review artifacts. Only the
# screenshots embedded in README.md are kept as narrow exceptions.
assets/screenshot/ui/*
!assets/screenshot/ui/3.0/

# Local environment files.
.env
.env.*
!.env.example
!**/.env.example
